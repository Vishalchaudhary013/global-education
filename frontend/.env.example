# Copy to .env (local) and set the same values in the Vercel project settings.
# Everything here is optional, but SEO stays partly inert without VITE_SITE_URL.

# The production origin, no trailing slash, e.g. https://www.example.com
# Used for canonical URLs, og:url, the robots.txt Sitemap line and the metadata
# the edge middleware injects. Left empty, absolute URLs are omitted rather
# than guessed — a wrong canonical is worse than none.
VITE_SITE_URL=

# Brand name appended to page titles. Defaults to GlobalEdu.
VITE_SITE_NAME=

# Social sharing image: an absolute URL, or a path served from /public.
# Needs to be a real 1200x630 PNG or JPEG — SVG is not supported by Facebook,
# LinkedIn or X. Left empty, no og:image is emitted.
VITE_OG_IMAGE=

# The site's X/Twitter handle, including the @. Only used for twitter:site.
VITE_TWITTER_SITE=

# API origin. Defaults to the Render deployment in src/api/axiosClient.js.
VITE_API_BASE_URL=
